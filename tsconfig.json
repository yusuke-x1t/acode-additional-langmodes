{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["acode-plugin-types"]
  },
  "exclude": ["./dist/**/*", "./postcss.config.js"]
}
